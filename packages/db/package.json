{
  "name": "@unipos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo 'db: run test:integration with a database'",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@unipos/core": "workspace:*",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "dotenv": "^17.2.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
