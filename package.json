{
  "name": "unipos",
  "private": true,
  "version": "0.1.0",
  "description": "UniPOS \u2014 modular, offline-first point of sale",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @unipos/web dev",
    "build": "pnpm --filter @unipos/db generate && pnpm --filter @unipos/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter @unipos/core test:coverage",
    "test:integration": "pnpm --filter @unipos/db test:integration",
    "test:e2e": "pnpm --filter @unipos/web test:e2e",
    "db:migrate": "pnpm --filter @unipos/db migrate:deploy",
    "db:seed": "pnpm --filter @unipos/db seed",
    "prepare": "husky || true",
    "changeset": "changeset"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
