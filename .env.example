# Copy to .env (root, for docker compose) or apps/web/.env.local (for pnpm dev)
DATABASE_URL=postgresql://unipos_app:unipos_app@localhost:5432/unipos
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unipos
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unipos_shadow
BETTER_AUTH_SECRET=change-me-to-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
POSTGRES_PASSWORD=postgres
# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=UniPOS <no-reply@localhost>
